# Copy to .env.local for local development, and add the same two variables in
# Vercel → Project → Settings → Environment Variables.
#
# Both come from Supabase → Project Settings → API keys. They are safe to expose to the
# browser: row-level security keeps every user inside their own files.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: per-file upload limit in MB (Supabase free plan maximum is 50).
# NEXT_PUBLIC_MAX_UPLOAD_MB=50
