# Supabase file index (optional)
#
# Koldrop keeps storing file bytes in Vercel Blob. These values add a Supabase Postgres
# table that stores the file list, which removes the expensive Blob `list()` calls
# (they are billed as "Advanced Operations").
#
# Copy this file to .env.local and fill in the values, then add the same two variables
# in the Vercel project settings. If they are absent the app falls back to listing Blob
# directly and nothing breaks.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
